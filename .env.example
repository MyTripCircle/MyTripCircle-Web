# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
DB_NAME=mytripcircle

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=https://your-api-domain.com
API_IP_PRIMARY=192.168.x.x

# ─── CORS / Front web ─────────────────────────────────────────────────────────
# Allowlist stricte des origines navigateur autorisées (séparées par des virgules).
# Obligatoire en production : l'authentification par cookie exige
# `credentials: true`, incompatible avec une origine wildcard.
# Dev Expo web : http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081,https://app.your-domain.com
# URL publique du front web — cible des redirections OAuth, du retour Stripe
# Checkout et du lien de réinitialisation de mot de passe. Vide = déploiement
# mobile seul (rebond vers le schéma d'app conservé).
WEB_APP_URL=http://localhost:8081
# Domaine des cookies d'authentification. À renseigner UNIQUEMENT si le front et
# l'API sont sur des sous-domaines distincts (ex: .your-domain.com). Sinon vide.
COOKIE_DOMAIN=

# ─── JWT (générer avec: openssl rand -base64 64) ──────────────────────────────
JWT_SECRET=change-me-before-production
REFRESH_SECRET=change-me-before-production

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
MAIL_USER=noreply@yourdomain.com
MAIL_PASS=your-gmail-app-password

# ─── URL de l'API vue par le client web ───────────────────────────────────────
# Inlinée dans le bundle au build. Sans elle, le serveur de développement local
# taperait directement sur l'API de production.
EXPO_PUBLIC_API_URL=http://localhost:4000

# ─── Google Places API (côté serveur uniquement — ne pas préfixer EXPO_PUBLIC_) ──
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ─── Google OAuth (Client IDs — préfixe EXPO_PUBLIC_ requis pour accès côté client) ──
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# URI de redirection OAuth web. Doit être déclarée À L'IDENTIQUE dans la console
# Google Cloud (Identifiants → client OAuth « Application Web » → URI de
# redirection autorisés). Vide = origine courante du navigateur.
EXPO_PUBLIC_GOOGLE_WEB_REDIRECT_URI=http://localhost:8081

# ─── Carte web (MapLibre) ─────────────────────────────────────────────────────
# URL d'un style MapLibre. Vide = tuiles raster OpenStreetMap publiques, réservées
# au développement : leur politique d'usage interdit le trafic d'une app en production.
EXPO_PUBLIC_MAP_STYLE_URL=

# ─── Chiffrement des données PII (openssl rand -hex 32) ───────────────────────
ENCRYPTION_KEY=64-char-hex-key
HMAC_KEY=64-char-hex-key

# ─── IA itinéraires (optionnel) ───────────────────────────────────────────────
GROQ_API_KEY=

# ─── Apple Sign-In (optionnel) ────────────────────────────────────────────────
APPLE_APP_ID=com.yourcompany.mytripcircle
APPLE_TEAM_ID=XXXXXXXXXX

# ─── In-App Purchases (IAP) ───────────────────────────────────────────────────
APPLE_SHARED_SECRET=your-app-store-connect-shared-secret
IAP_SKIP_VALIDATION=false

# ─── Stripe (abonnements web) ─────────────────────────────────────────────────
# Optionnel : sans STRIPE_SECRET_KEY, /subscriptions/checkout-session répond 503
# et l'IAP mobile continue de fonctionner normalement.
# Clé secrète API (Dashboard > Développeurs > Clés API)
STRIPE_SECRET_KEY=
# Secret de signature du endpoint webhook (Dashboard > Webhooks, ou `stripe listen`)
# Requis pour vérifier l'authenticité de POST /subscriptions/webhook
STRIPE_WEBHOOK_SECRET=
# Identifiants de prix Stripe associés aux productId applicatifs
# com.myapp.monthly / com.myapp.yearly — jamais exposés au navigateur
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Optionnel : sans clés, les routes /users/push/* répondent 503 et l'envoi est
# désactivé (aucun crash au démarrage).
# Générer la paire avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact de l'émetteur exigé par la spec VAPID (mailto: ou URL du site)
VAPID_SUBJECT=mailto:contact@your-domain.com

# ─── Android App Links ────────────────────────────────────────────────────────
# SHA256 du certificat de signature de l'APK — obtenir via : eas credentials
# Format : AA:BB:CC:DD:... (séparateurs deux-points, 32 octets)
ANDROID_SHA256_FINGERPRINT=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99